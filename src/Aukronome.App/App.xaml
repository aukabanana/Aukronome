<Application x:Class="Aukronome.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- RawBlock Design System Color Palette -->
        <SolidColorBrush x:Key="RawBlackBrush" Color="#000000" />
        <SolidColorBrush x:Key="RawWhiteBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="RawBlueBrush" Color="#0000FF" />
        <SolidColorBrush x:Key="RawSurfaceSunkenBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="RawSurfaceHoverBrush" Color="#E8E8E8" />
        <SolidColorBrush x:Key="RawBorderDisabledBrush" Color="#CCCCCC" />
        <SolidColorBrush x:Key="RawDisabledBgBrush" Color="#F5F5F5" />
        <SolidColorBrush x:Key="RawDisabledTextBrush" Color="#888888" />
        <SolidColorBrush x:Key="RawSuccessBrush" Color="#008000" />
        <SolidColorBrush x:Key="RawWarningBrush" Color="#FFA500" />
        <SolidColorBrush x:Key="RawErrorBrush" Color="#FF0000" />

        <!-- Backward-Compatible Palette Mapping to RawBlock Base (#FFFFFF) -->
        <SolidColorBrush x:Key="BgPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BgInputBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="BgHoverBrush" Color="#E8E8E8" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#000000" />
        <SolidColorBrush x:Key="BorderBlackBrush" Color="#000000" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#000000" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#444444" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#000000" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#000000" />
        <SolidColorBrush x:Key="AccentEmeraldBrush" Color="#008000" />
        <SolidColorBrush x:Key="AccentDangerBrush" Color="#FF0000" />

        <!-- RawBlock Font Families -->
        <FontFamily x:Key="HeadlineFont">Archivo Black, Arial Black, Impact, Segoe UI Black, sans-serif</FontFamily>
        <FontFamily x:Key="BodyFont">Work Sans, Segoe UI, Arial, sans-serif</FontFamily>
        <FontFamily x:Key="MonoFont">Space Mono, Consolas, Courier New, monospace</FontFamily>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- RawBlock Primary Button (Black fill, White text, 3px border, 0px radius) -->
        <Style x:Key="RawBlockPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource RawBlackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RawWhiteBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RawBlackBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="FontFamily" Value="{StaticResource HeadlineFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawWhiteBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource RawBlackBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawBlackBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="5" />
                                <Setter Property="Foreground" Value="{StaticResource RawWhiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawDisabledBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RawBorderDisabledBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource RawDisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RawBlock Secondary Button (White fill, Black text, 3px border, 0px radius) -->
        <Style x:Key="RawBlockSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource RawWhiteBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RawBlackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RawBlackBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="FontFamily" Value="{StaticResource HeadlineFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawBlackBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource RawWhiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawBlackBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="5" />
                                <Setter Property="Foreground" Value="{StaticResource RawWhiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawDisabledBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RawBorderDisabledBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource RawDisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Alias DarkButtonStyle to RawBlockSecondaryButton for existing buttons -->
        <Style x:Key="DarkButtonStyle" TargetType="Button" BasedOn="{StaticResource RawBlockSecondaryButton}" />

        <!-- RawBlock Destructive Button (Error red fill, 3px border) -->
        <Style x:Key="RawBlockDestructiveButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource RawErrorBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RawWhiteBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RawBlackBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="FontFamily" Value="{StaticResource HeadlineFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawBlackBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource RawErrorBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawDisabledBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RawBorderDisabledBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource RawDisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RawBlock Input (TextBox: sunken #F0F0F0, 3px border, square, Space Mono) -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource RawSurfaceSunkenBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RawBlackBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource RawBlackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RawBlackBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="5" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawWhiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawDisabledBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RawBorderDisabledBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource RawDisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RawBlock ComboBox Item Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource RawWhiteBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RawBlackBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawBlackBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource RawWhiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RawBlackBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource RawWhiteBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RawBlock ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource RawBlackBrush}" />
            <Setter Property="Background" Value="{StaticResource RawSurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RawBlackBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{StaticResource RawSurfaceSunkenBrush}"
                                                BorderBrush="{StaticResource RawBlackBrush}"
                                                BorderThickness="3"
                                                CornerRadius="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="{StaticResource RawBlackBrush}" Width="28">
                                                    <Path HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                                          Fill="{StaticResource RawWhiteBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource RawSurfaceHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,32,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="False"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource RawWhiteBrush}"
                                            BorderThickness="3"
                                            BorderBrush="{StaticResource RawBlackBrush}"
                                            CornerRadius="0"
                                            Margin="0,-1,0,0">
                                        <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RawBlock Slider Style (Track: 3px black border, sunken fill; Thumb: 3px square black block) -->
        <Style x:Key="RawBlockSliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Width="16" Height="26"
                                Background="{StaticResource RawBlackBrush}"
                                BorderBrush="{StaticResource RawBlackBrush}"
                                BorderThickness="3"
                                CornerRadius="0"
                                Cursor="SizeWE" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource RawWhiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource RawWhiteBrush}" />
                                <Setter TargetName="ThumbBorder" Property="BorderThickness" Value="5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Brutalist Track -->
                            <Border Height="12"
                                    Background="{StaticResource RawSurfaceSunkenBrush}"
                                    BorderBrush="{StaticResource RawBlackBrush}"
                                    BorderThickness="3"
                                    CornerRadius="0" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource RawBlockSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
